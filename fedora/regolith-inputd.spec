# Generated by porting/scripts/gen-fedora-packaging.py from regolith-inputd/debian/. Do not edit by hand.
Name:           regolith-inputd
Version:        0.6.1
Release:        1%{?dist}
Summary:        Daemon for synchronizing between
License:        Apache-2.0
URL:            https://github.com/regolith-linux/regolith-inputd
Source0:        %{name}-%{version}.tar.gz

# Rust binaries carry no debug-friendly build-id split yet; keep debuginfo off for the POC
%global debug_package %{nil}
BuildRequires:  make
BuildRequires:  cargo
BuildRequires:  rust
BuildRequires:  systemd-rpm-macros
BuildRequires:  pkgconfig(glib-2.0)
BuildRequires:  gsettings-desktop-schemas
BuildRequires:  glib2
BuildRequires:  gnome-settings-daemon
BuildRequires:  dbus-daemon
%{?systemd_requires}

Recommends:     gnome-control-center

%description
the input states stored in gsettings and sway
by providing relevant dbus bindings

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > regolith-inputd.files

%post -n regolith-inputd
%systemd_user_post regolith-init-inputd.service

%preun -n regolith-inputd
%systemd_user_preun regolith-init-inputd.service

%files -f regolith-inputd.files

